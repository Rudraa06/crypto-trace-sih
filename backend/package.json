{
  "name": "cryptotrace-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SIH 2026 / MHA - Real-time identification of fraud-linked cryptocurrency exchanges. Phases 1-3: blockchain ingestion, Neo4j graph persistence, and shortestPath cash-out tracing.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:fixtures": "node scripts/generate-fixtures.js",
    "seed:exchanges": "node scripts/seed-exchanges.js",
    "smoke": "node scripts/smoke.js",
    "smoke:graph": "node scripts/smoke-graph.js",
    "smoke:trace": "node scripts/smoke-trace.js",
    "verify": "npm run smoke && npm run smoke:graph && npm run smoke:trace",
    "test:security": "node scripts/test-security.js",
    "test:load": "node scripts/load-test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "neo4j-driver": "^5.28.1",
    "uuid": "^14.0.2"
  }
}
